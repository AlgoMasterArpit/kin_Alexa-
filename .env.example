HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

KIN_DB_PATH=data/kin.db
KIN_TIMEZONE=Asia/Kolkata
KIN_PARENT_NAME=Mom

# Required when HOST is not a loopback address. Generate with: openssl rand -hex 32
KIN_API_TOKEN=
# Comma-separated hostnames allowed in the Host header when HOST is not a loopback address.
KIN_ALLOWED_HOSTS=

# Family push alerts through ntfy.sh. Pick a long, hard-to-guess topic and subscribe to it in the ntfy app.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

# Background checks that alert the family without waiting for the parent to speak.
KIN_WATCHDOG_ENABLED=true
KIN_WATCHDOG_INTERVAL_MINUTES=15
KIN_DAILY_SUMMARY_TIME=21:30

# Weekly family digest written by Claude on Amazon Bedrock. Uses the default AWS credential chain.
BEDROCK_ENABLED=false
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL=anthropic.claude-opus-5-5
